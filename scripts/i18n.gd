static func t(key: String, args: Array = []) -> String:
	var lang: String = Settings.language
	var table: Dictionary = STRINGS.get(lang, STRINGS["tr"])
	var s: String = table.get(key, STRINGS["tr"].get(key, key))
	if args.is_empty():
		return s
	return s % args

static func decode_stage(stage: String) -> String:
	if stage.begins_with("decode|"):
		var parts := stage.split("|")
		if parts.size() >= 4:
			return t("decode_decoding", [
				String(parts[1]), int(parts[2]), int(parts[3])])
	match stage:
		"normalize", "Normalize ediliyor...":
			return t("decode_normalizing")
		"write_wav", "WAV yazılıyor...":
			return t("decode_writing_wav")
		"complete", "Tamamlandı":
			return t("decode_complete")
	if stage.begins_with("Çözümleniyor: "):
		return t("decode_decoding_legacy", [
			stage.trim_prefix("Çözümleniyor: ")])
	return stage

static func instrument_name(inst_key: String) -> String:
	return t("inst_" + inst_key)

static func difficulty_name(diff: String) -> String:
	return t("diff_" + diff)

static func preset_name(preset: String) -> String:
	return t("preset_" + preset)
