static func t(key: String, args: Array = []) -> String:
	var lang: String = Settings.language
	var table: Dictionary = STRINGS.get(lang, STRINGS["tr"])
	var s: String = table.get(key, STRINGS["tr"].get(key, key))
	if args.is_empty():
		return s
	return s % args

static func instrument_name(inst_key: String) -> String:
	return t("inst_" + inst_key)

static func difficulty_name(diff: String) -> String:
	return t("diff_" + diff)

static func preset_name(preset: String) -> String:
	return t("preset_" + preset)
