{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta').child('host_uid').val() == auth.uid) || (data.exists() && data.child('meta').child('host_uid').val() == auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','ready','song_ok']) && newData.child('uid').val() == $uid && newData.child('name').isString() && newData.child('name').val().length <= 18)"
          }
        },
        "answers": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid"
          }
        },
        "ice": {
          "guest": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid"
            }
          }
        }
      }
    }
  }
}
